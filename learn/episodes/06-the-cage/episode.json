   "heading": "Permission prompts",
   "shot": "yolo",
   "lines": [
    {
     "id": "y1",
     "text": "Permission prompts stay on by default: the session asks first."
    },
    {
     "id": "y2",
     "text": "YOLO mode switches them off for that one session."
    },
    {
     "id": "y3",
     "text": "That is your choice. The agent then acts without asking, and only a sandbox, if you chose one, still limits it."
    }
