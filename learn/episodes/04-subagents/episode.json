      "heading": "Subagents",
      "shot": "chat",
      "lines": [
        {
          "id": "c1",
          "text": "An agent can hand parts of a job to subagents, which work in the background."
        },
        {
          "id": "c2",
          "text": "While they run, a Subagents card floats in the corner of the chat."
        },
        {
          "id": "c3",
          "text": "Each row shows its model and the step it is on right now."
