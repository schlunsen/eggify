---
import logo from '../assets/logo.svg';
---
<footer>
  <div class="wrap">
    <div>
      <a class="brand" href="/#top"><img src={logo.src} alt="" width="40" height="40" />Eggify</a>
      <small>No eggs were harmed in the making of this website. One was stepped on, but he's fine.</small>
    </div>
    <nav class="links" aria-label="Footer">
      <a href="/learn/">Learn</a>
      <a href="/#install">Install</a>
      <a href="/#download">Get Eggify</a>
      <a href="https://github.com/schlunsen/eggify">GitHub</a>
    </nav>
    <div>The AI workstation for writing code · Made for macOS · Free and open source (MIT)</div>
  </div>
</footer>

<style>
  footer {
    margin-top: 110px;
    background: var(--umber);
    color: #cdbb98;
    padding: 48px 0 40px;
    font-size: 17px;
    border-top: 6px solid var(--pink);
    box-shadow: 0 -12px 0 var(--mustard), 0 -18px 0 var(--teal);
  }
  .wrap { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .brand { color: var(--paper-light); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 22px; font-family: var(--mono); font-size: 15px; text-transform: uppercase; letter-spacing: 0.06em; }
  .links a { color: var(--paper-light); text-decoration: none; border-bottom: 2px solid transparent; }
  .links a:hover { border-bottom-color: var(--pink); }
  small { display: block; font-style: italic; margin-top: 4px; }
</style>
