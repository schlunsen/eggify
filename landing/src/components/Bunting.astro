---
// Bunting: one swag of flags along a gentle curve, drawn once (not tiled), hung just
// below its positioned parent. The flags sway as if in a slow wind: each swings from
// its top edge, a little later than its left neighbour, so gusts travel along the line.
const flagColors = ['#e8458b', '#d4a017', '#2a9d8f', '#fbf5e6'];
const flags = Array.from({ length: 34 }, (_, i) => {
  const t = i / 33;
  return {
    x: 12 + i * 47,
    y: 6 + Math.sin(t * Math.PI * 2) ** 2 * 16,
    c: flagColors[i % 4],
    // Travelling wave, plus a little irregularity so it never looks mechanical.
    delay: -(i * 0.21 + (i % 3) * 0.35),
    dur: 5.2 + (i % 5) * 0.45,
  };
});
const tri = (f: { x: number; y: number }) =>
  `M${f.x} ${f.y} L${f.x + 40} ${f.y + 1} L${f.x + 20} ${f.y + 26} Z`;
---
<svg class="bunting" viewBox="0 0 1600 50" preserveAspectRatio="none" aria-hidden="true">
  {flags.map((f) => (
    <path class="flag shade" d={tri(f)} transform="translate(1.2 2)" style={`animation-delay:${f.delay}s;animation-duration:${f.dur}s`} />
  ))}
  <path d={`M0 6 ${flags.map((f) => `L${f.x + 20} ${f.y + 1}`).join(' ')} L1600 6`} fill="none" stroke="#2b1d10" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  {flags.map((f) => (
    <path class="flag" d={tri(f)} fill={f.c} stroke="#2b1d10" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" style={`animation-delay:${f.delay}s;animation-duration:${f.dur}s`} />
  ))}
</svg>

<style>
  .bunting {
    position: absolute;
    left: 0;
    top: calc(100% + 3px);
    width: 100%;
    height: 40px;
    overflow: visible;
  }
  .flag {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: bunting-wind 5.2s ease-in-out infinite;
  }
  .shade {
    fill: rgba(43, 29, 16, 0.18);
  }
  /* Mostly leaning downwind, with one lazy swing back: a breeze, not a pendulum. */
  @keyframes bunting-wind {
    0% { transform: skewX(-3deg) scaleY(1); }
    30% { transform: skewX(-13deg) scaleY(0.95); }
    48% { transform: skewX(-8deg) scaleY(0.98); }
    66% { transform: skewX(-15deg) scaleY(0.93); }
    86% { transform: skewX(2deg) scaleY(1.01); }
    100% { transform: skewX(-3deg) scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flag { animation: none; }
  }
</style>
