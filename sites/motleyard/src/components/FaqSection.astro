---
import type { FAQ } from '../data/types';
interface Props {
  items: readonly FAQ[];
  title?: string;
}
const { items, title = 'A few good questions.' } = Astro.props;
---

<section class="faq wrap">
  <h2>{title}</h2>
  <div>
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
