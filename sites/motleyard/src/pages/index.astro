---
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkspacePreview from '../components/WorkspacePreview.astro';
import MachineArt from '../components/MachineArt.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FaqSection from '../components/FaqSection.astro';
import { pageContent } from '../data/pages';
const content = pageContent.index;
---

<SiteLayout title="A place to build what’s next">
  <section class="hero wrap">
    <div class="hero-top">
      <div class="eyebrow">
        <span class="dot"></span> A workspace for independent builders
      </div>
      <span class="edition">MOTLEYARD / EST. 2026</span>
    </div>
    <h1>
      Big ideas.
      <br />A <span class="highlight">motley crew.</span>
      <br />
      Your kind of work.
    </h1>
    <div class="hero-bottom">
      <p>
        Your agents. Your projects. A place to build.
        <br />
        On your own Mac, or one you rent from us.
      </p>
      <div class="actions">
        <a class="btn" href="/workspace.html">
          Explore the workspace <span>↗</span>
        </a>
        <a class="text-link" href="/machines.html">
          Rent a machine ↗
        </a>
      </div>
    </div>
    <WorkspacePreview />
    <div class="integration">
      <span>BRING THE TOOLS YOU TRUST</span>
      <div class="providers">
        <span>✳ Claude</span>
        <span>⌘ Codex</span>
        <span>⑂ Git</span>
        <span class="plus">+ YOUR WORKFLOW</span>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-intro">
      <div class="eyebrow">02 / ROOM TO MAKE</div>
      <div>
        <h2>
          Less managing tabs.
          <br />
          More making things.
        </h2>
        <p>
          One project or a dozen side quests. Motleyard gives your coding agents
          a shared home, and you a clear view of the work.
        </p>
      </div>
    </div>
    <FeatureGrid items={content.features} />
  </section>
  <section class="machine-section" id="machine">
    <div class="machine-layout wrap">
      <div>
        <div class="eyebrow">03 / THE WORKSHOP, DELIVERED</div>
        <h2>
          Rent the machine.
          <br />
          Build the thing.
        </h2>
        <p>
          A Mac, Motleyard, and your coding tools, brought together in one
          setup. Choose an M5 Pro or M5 Max rental and give your next idea a
          dedicated home.
        </p>
        <a class="btn light-btn" href="/machines.html">
          Meet the machines<span>↗</span>
        </a>
        <p class="note">Explore our proposed rental lineup.</p>
      </div>
      <MachineArt label="ILLUSTRATIVE FORM STUDY / NOT AN APPLE PRODUCT RENDER" />
    </div>
  </section>
  <section class="section wrap license" id="license">
    <div class="license-copy">
      <div class="eyebrow">04 / MAKE IT YOURS</div>
      <h2>
        Good tools.
        <br />
        Clear terms.
      </h2>
      <p>
        A paid workspace for people who build. One serial number, room for your
        computers, and time away from the internet when you need it.
      </p>
      <p>
        We’re preparing the first licensed release. Pricing and purchase details
        will follow.
      </p>
    </div>
    <div class="license-box">
      <div class="eyebrow">
        <span>The workspace license</span>
        <span>↗</span>
      </div>
      <h3>Your yard. Up to 3 computers.</h3>
      <ul>
        <li>One serial number for up to 3 active installs</li>
        <li>Up to 30 days offline between license checks</li>
        <li>Licensed remote access through the relay</li>
        <li>iPhone access through your licensed Mac</li>
      </ul>
      <p>
        PAID RELEASE IN PREPARATION
        <br />
        No free tier or trial is currently planned.
      </p>
    </div>
  </section>
  <FaqSection items={content.faqs} />
</SiteLayout>
