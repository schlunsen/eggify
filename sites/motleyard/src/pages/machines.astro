---
import SiteLayout from '../layouts/SiteLayout.astro';
import MachineOffer from '../components/MachineOffer.astro';
import PageHero from '../components/PageHero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StepList from '../components/StepList.astro';
import FaqSection from '../components/FaqSection.astro';
import { pageContent } from '../data/pages';
const content = pageContent.machines;
---

<SiteLayout title="Rent the machine. Build the thing.">
  <PageHero
    eyebrow="MOTLEYARD MACHINES"
    description="Rent a Mac with a purpose: building your next thing. Motleyard and your chosen developer tools, brought together before the first prompt."
  >
    <Fragment slot="title">
      Less setup.
      <br />
      More <span class="highlight">starting.</span>
    </Fragment>
    <div class="actions">
      <a class="btn" href="/configure.html">
        Configure your rental<span>↗</span>
      </a>
      <a class="text-link" href="#compare">
        Compare the lineup ↓
      </a>
    </div>
  </PageHero>
  <section class="wrap offer-grid">
    <MachineOffer
      tier="pro"
      eyebrow="THE EVERYDAY WORKSHOP"
      description="For the daily rhythm of making software: your editor, projects, coding agents, and the next thing you want to ship."
    />
    <MachineOffer
      tier="max"
      eyebrow="THE BIGGER WORKSHOP"
      description="For builders who want to explore a higher-tier Mac setup for a broader mix of development and creative work."
    />
  </section>
  <div class="wrap">
    <p class="note">
      Proposed rental tiers. Exact Apple model, memory, storage, availability,
      and monthly rates are not specified in this concept.
    </p>
  </div>
  <section class="section wrap">
    <div class="section-intro">
      <div class="eyebrow">WHAT MAKES IT A MOTLEYARD</div>
      <div>
        <h2>
          The computer is
          <br />
          only the beginning.
        </h2>
        <p>
          The offer we’re building is the whole starting point: a machine, an
          organized workspace, and the tools you actually want to use.
        </p>
      </div>
    </div>
    <FeatureGrid items={content.features} />
  </section>
  <section class="band">
    <div class="wrap split">
      <div>
        <div class="eyebrow">FROM BOX TO BUILD</div>
        <h2>A better first day.</h2>
        <p>
          Choose the setup. Connect your accounts. Bring in your projects. The
          first thing you build should be your idea.
        </p>
      </div>
      <StepList items={content.steps} />
    </div>
  </section>
  <section class="section wrap" id="compare">
    <div class="eyebrow">TWO WAYS INTO THE YARD</div>
    <h2 class="comparison-heading">Bring a Mac. Or rent one.</h2>
    <table class="comparison">
      <thead>
        <tr>
          <th>What you get</th>
          <th>Workspace license</th>
          <th>Machine rental concept</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>Computer</th>
          <td>Your existing computer</td>
          <td>Proposed M5 Pro / M5 Max Mac</td>
        </tr>
        <tr>
          <th>Motleyard</th>
          <td>Paid serial, up to 3 installs</td>
          <td>Planned as part of the setup</td>
        </tr>
        <tr>
          <th>Agent tools</th>
          <td>Use your own setup</td>
          <td>Choose tools for preinstallation</td>
        </tr>
        <tr>
          <th>Provider accounts</th>
          <td>Your own</td>
          <td>Your own</td>
        </tr>
        <tr>
          <th>Price</th>
          <td>To be announced</td>
          <td>To be announced</td>
        </tr>
      </tbody>
    </table>
  </section>
  <FaqSection items={content.faqs} />
</SiteLayout>
